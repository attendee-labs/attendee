# Experimental local-development variant contributed by Victor Wads.
# Meet validated; Teams unvalidated; native Zoom SDK deliberately excluded.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-gi python3-gst-1.0 \
    build-essential pkg-config libpq-dev libssl-dev libffi-dev \
    tini ca-certificates curl git \
    xvfb xauth x11-utils xterm xclip fonts-liberation \
    pulseaudio pulseaudio-utils alsa-utils libasound2-plugins ffmpeg \
    libgl1 libglib2.0-0 libgirepository1.0-dev \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-alsa \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/venv \
    && ln -s /usr/bin/chromedriver /usr/local/bin/chromedriver \
    && ln -s /usr/bin/chromium /usr/bin/google-chrome
# Official Debian archive: Chromium and driver match upstream's 134.0.6998.88.
# Legacy browser for isolated compatibility testing, not general-purpose browsing.
RUN curl -fsSL --retry 3 https://snapshot.debian.org/file/ab1d6847cc34618af1656ed8f15fe99c89bbfabd -o /tmp/chromium.deb \
    && curl -fsSL --retry 3 https://snapshot.debian.org/file/ee532b2e74fb2f0f9d47bb301be972105a7a6ac2 -o /tmp/chromium-common.deb \
    && curl -fsSL --retry 3 https://snapshot.debian.org/file/4c764c95d54874c79242745708d302d235cbf6a6 -o /tmp/chromium-driver.deb \
    && echo "92960c257544cf778fc32d210ce30eda0df505d810145959e1fff8a09e73edb8  /tmp/chromium.deb" | sha256sum -c - \
    && echo "c378225c7da41cd78cefff8221a753dbb997e818aab9c21a95ffa45c75d171db  /tmp/chromium-common.deb" | sha256sum -c - \
    && echo "fdc30b76895dadf05b588ed5b0e61e29bf138ca3fd53b80a87fc24b6f39c570c  /tmp/chromium-driver.deb" | sha256sum -c - \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/chromium.deb /tmp/chromium-common.deb /tmp/chromium-driver.deb \
    && apt-mark hold chromium chromium-common chromium-driver \
    && rm -f /tmp/chromium.deb /tmp/chromium-common.deb /tmp/chromium-driver.deb \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /attendee
COPY requirements.txt /tmp/requirements-original.txt
RUN sed '/^zoom-meeting-sdk==/d' /tmp/requirements-original.txt > /tmp/requirements-arm64.txt \
    && pip install --no-cache-dir --prefer-binary -r /tmp/requirements-arm64.txt
RUN useradd -m -u 1000 -s /bin/bash app \
    && mkdir -p /etc/chromium/policies/managed /etc/opt/chrome/policies/managed \
    && ln -s /tmp/attendee-chrome-policies.json /etc/chromium/policies/managed/attendee-chrome-policies.json \
    && ln -s /tmp/attendee-chrome-policies.json /etc/opt/chrome/policies/managed/attendee-chrome-policies.json
COPY --chown=app:app --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=app:app . .
RUN mkdir -p /attendee/staticfiles && chown app:app /attendee/staticfiles
USER app
ENTRYPOINT ["/usr/bin/tini","--","/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
