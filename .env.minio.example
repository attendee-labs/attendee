# MinIO Storage Configuration Example
# Copy this file to .env and fill in your values

# Set storage protocol to minio
STORAGE_PROTOCOL=minio

# MinIO Server Configuration
MINIO_ENDPOINT_URL=http://minio:9000
# Endpoint used in download links handed out to clients (must be reachable from the browser)
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Bucket names
MINIO_RECORDING_STORAGE_BUCKET_NAME=attendee-recordings
# MINIO_AUDIO_CHUNK_STORAGE_BUCKET_NAME=attendee-audio-chunks  # Optional, defaults to MINIO_RECORDING_STORAGE_BUCKET_NAME

# Audio chunk storage settings (optional)
USE_REMOTE_STORAGE_FOR_AUDIO_CHUNKS=false
FALLBACK_TO_DB_STORAGE_FOR_AUDIO_CHUNKS_IF_REMOTE_STORAGE_FAILS=false

# All storage is handled via MinIO env vars
