{
  "platforms": {
    "google_meet": {
      "domain_allowlist": [
        "accounts.google.com",
        "accounts.google.co.in",
        "accounts.google.co.id",
        "accounts.google.com.br",
        "accounts.google.com.mx",
        "accounts.google.co.jp",
        "accounts.google.de",
        "accounts.google.co.uk",
        "accounts.google.fr",
        "accounts.google.ca",
        "accounts.google.com.au",
        "accounts.google.co.kr",
        "accounts.google.es",
        "accounts.google.it",
        "accounts.google.com.ph",
        "accounts.google.com.ng",
        "accounts.google.com.pk",
        "accounts.google.com.vn",
        "accounts.google.nl",
        "accounts.google.com.sg",
        "workspace.google.com",
        "mail.google.com",
        "meet.google.com",
        "www.google.com",
        ".apps.google.com"
      ]
    },
    "teams": {
      "domain_allowlist": [
        "teams.microsoft.com",
        "teams.live.com",
        "login.live.com",
        "teams.microsoft.us",
        "m365.cloud.microsoft",
        "static.microsoft",
        "login.microsoftonline.com",
        "login.microsoftonline.us",
        "www.office.com"
      ],
      "selectors": {
        "microphone_button": { "type": "css", "selector": "[data-tid=\"toggle-mute\"]" },
        "camera_button": { "type": "css", "selector": "[data-tid=\"toggle-video\"]" },
        "join_button": { "type": "css", "selector": "[data-tid=\"prejoin-join-button\"]" },
        "cancel_join_button": { "type": "css", "selector": "[data-tid=\"prejoin-cancel-button\"]" },
        "name_input": { "type": "css", "selector": "[data-tid=\"prejoin-display-name-input\"]" },
        "language_and_speech_button": { "type": "id", "selector": "LanguageSpeechMenuControl-id" },
        "closed_captions_button": { "type": "id", "selector": "closed-captions-button" },
        "show_more_button": { "type": "css", "selector": "#callingButtons-showMoreBtn" },
        "request_denied_dismiss_button": { "type": "css", "selector": "[data-tid=\"calling-retry-cancelbutton\"]" },
        "view_button": { "type": "css", "selector": "#view-mode-button, #custom-view-button" },
        "speaker_view_button": { "type": "css", "selector": "#custom-view-button-SpeakerViewButton, #SpeakerView-button" },
        "gallery_view_button": { "type": "css", "selector": "#custom-view-button-MixedGridButton, #MixedGrid-button, #MixedGridView-button" },
        "turn_off_incoming_video_button": { "type": "css", "selector": "#incoming-video-button, #toggle-incoming-video-button, [data-track-module-name=\"incomingVideoButton\"]" },
        "view_more_options_button": { "type": "css", "selector": "#ViewModeMoreOptionsMenuControl-id" },
        "leave_button": { "type": "css", "selector": "[data-inp=\"hangup-button\"], #hangup-button" },
        "microsoft_login_form_email_input": { "type": "css", "selector": "input[name=\"loginfmt\"][type=\"email\"]" },
        "login_username_input": { "type": "css", "selector": "input[name=\"loginfmt\"]" },
        "login_username_error": { "type": "id", "selector": "usernameError" },
        "login_password_input": { "type": "css", "selector": "input[name=\"passwd\"]" },
        "login_submit_button": { "type": "css", "selector": "input[type=\"submit\"]" },
        "login_incorrect_password_message": { "type": "xpath", "selector": "//*[contains(text(), \"Your account or password is incorrect\")]" },
        "waiting_to_be_admitted_message": { "type": "xpath", "selector": "//*[contains(text(), \"Someone will let you in soon\")]" },
        "captcha_message": { "type": "xpath", "selector": "//*[contains(text(), \"Verify you're a real person\")]" },
        "invalid_meeting_url_message": { "type": "xpath", "selector": "//*[contains(text(), \"Looks like the meeting URL is incorrect. Please check the URL and try again.\")]" },
        "could_not_connect_message": { "type": "xpath", "selector": "//*[contains(text(), \"we couldn't connect you\")]" },
        "request_denied_message": {
          "type": "xpath",
          "selector": [
            "//*[contains(text(), \"but you were denied access to the meeting\")]",
            "//*[contains(text(), \"Your request to join was declined\")]"
          ]
        },
        "sign_in_required_message": {
          "type": "xpath",
          "selector": [
            "//*[contains(text(), \"We need to verify your info before you can join\")]",
            "//*[contains(text(), \"To join, sign in or use Teams on the web\")]",
            "//*[contains(text(), \"You need to be signed in to Teams to access this meeting. Sign in with a work or school account and try joining again.\")]",
            "//*[contains(text(), \"If you're not signed in to a Teams (work or school) account, sign in and try joining again. If you still can't join, contact the organizer.\")]",
            "//*[contains(text(), \"Sign in to Teams to join, or contact the meeting organizer\")]",
            "//*[contains(text(), \"To join this Teams meeting, you need to be signed in to an account.\")]",
            "//*[contains(text(), \"To join this meeting, sign in again or select another account.\")]",
            "//*[contains(text(), \"Due to org policy, you need to sign in or use Teams on the web to join this meeting.\")]",
            "//*[contains(text(), \"External participants are not permitted to join before the event begins. Please join after the event has started.\")]"
          ]
        }
      }
    },
    "zoom_web": {
      "domain_allowlist": [
        "www.zoom.com",
        "127.0.0.1"
      ]
    }
  }
}
